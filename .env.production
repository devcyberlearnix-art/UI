# ==============================================================================
# CyberLearnIX / FD_LMS Enterprise Production Environment Configuration
# ==============================================================================
# NOTE: In production Kubernetes or Docker environments where the UI is served
# behind an Ingress or Nginx reverse proxy, relative paths ("/api") should be used
# to ensure zero-CORS overhead and seamless session cookie handling.
# If hosting the presentation layer on a dedicated CDN or static host (e.g. S3/CloudFront/Vercel),
# set VITE_API_BASE_URL to your public API Gateway domain (e.g. https://api.cyberlearnix.com).
# ==============================================================================

# Application Environment Mode
VITE_APP_ENV=production
VITE_APP_NAME="CyberLearnIX Enterprise Platform"
VITE_APP_VERSION="1.0.0"

# API Gateway Domain Gateway
# When empty, axiosInstance defaults to relative paths ("/api/v1/...") routed via Ingress/Nginx
VITE_API_BASE_URL=
# Example cross-domain configuration:
# VITE_API_BASE_URL=https://gateway.cyberlearnix.io

# Real-Time WebSocket & STOMP Broker Configuration
# When empty, stompClient automatically derives ws:// or wss:// from window.location.host
VITE_WS_URL=
# Example cross-domain WebSocket configuration:
# VITE_WS_URL=wss://gateway.cyberlearnix.io/ws/notifications/websocket

# Content Delivery Network (CDN) Assets & Media URL
VITE_CDN_BASE_URL=
VITE_ASSETS_CACHE_TTL=31536000

# High-Resilience & Architectural Feature Flags
VITE_FEATURE_RESILIENT_CHECKOUT=true
VITE_FEATURE_STAMPEDE_CACHE=true
VITE_FEATURE_REALTIME_NOTIFICATIONS=true
VITE_FEATURE_ANALYTICS_TELEMETRY=true
VITE_FEATURE_CHAOS_TELEMETRY=false

# Observability & Monitoring
VITE_ENABLE_PERFORMANCE_OBSERVER=true
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Network Timeouts & Retry Policies
VITE_API_TIMEOUT_MS=30000
VITE_API_MAX_RETRIES=2
