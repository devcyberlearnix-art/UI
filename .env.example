# .env.example
# Development: Leave empty to use Vite proxy
# Production: Set to backend API gateway URL
# VITE_API_BASE_URL=https://matted-ascent-specimen.ngrok-free.dev

# Google Drive & OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_FOLDER_ID=your-google-folder-id

# Mail Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=cyberlearnix@gmail.com
SPRING_MAIL_PASSWORD="your-app-password"
